        <attribute name="edited" value="bXVoYW07SFAtU1lBSFJJTC0xMDE4OzIwMjYtMDktMTk7MDE6MzU6NDggUE07MztMRU5PVk87REVTS1RPUC01UU1ERThJOzIwMjYtMDktMTQ7MDk6MTg6MzUgUE07Y2FzZSA2IChvbiBnb2luZykgKHJldmlzaSkgKDQpLmZwcmc7ODY3Mg=="/>
        <attribute name="edited" value="bXVoYW07SFAtU1lBSFJJTC0xMDE4OzIwMjYtMDktMTk7MDM6MDk6MTEgUE07NDtMRU5PVk87REVTS1RPUC01UU1ERThJOzIwMjYtMDktMTQ7MDk6MTg6MzUgUE07Y2FzZSA2IChvbiBnb2luZykgKHJldmlzaSkgKDUpLmZwcmc7ODY2Nw=="/>
        <attribute name="edited" value="bXVoYW07SFAtU1lBSFJJTC0xMDE4OzIwMjYtMDktMTk7MDM6NTI6NDMgUE07MzsyOTIw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="MenghitungUlang, Ulang, TidakUlang, Y, N, jamMulai, menitMulai, jamSelesai, menitSelesai, totalMenitMulai, totalMenitSelesai, selisihMenit, durasiJam, durasiMenit, DurasiPerhitungan" type="Integer" array="False" size=""/>
            <output expression="&quot;Menghitung Ulang? Y = 1, N = 0&quot;" newline="True"/>
            <input variable="MenghitungUlang"/>
            <if expression="MenghitungUlang &gt; 0">
                <then>
                    <output expression="&quot;Ulang&quot;" newline="True"/>
                    <input variable="Ulang"/>
                    <while expression="Ulang &gt; 0">
                        <input variable="jamMulai"/>
                        <input variable="menitMulai"/>
                        <input variable="jamSelesai"/>
                        <input variable="menitSelesai"/>
                        <assign variable="totalMenitMulai" expression="jamMulai * 60 + menitMulai"/>
                        <assign variable="totalMenitSelesai" expression="jamSelesai * 60 + menitSelesai"/>
                        <if expression="totalMenitSelesai &gt;= totalMenitMulai">
                            <then>
                                <assign variable="SelisihMenit" expression="totalMenitSelesai - totalMenitMulai"/>
                            </then>
                            <else>
                                <assign variable="selisihMenit" expression="(24 * 60 - totalMenitMulai) + totalMenitSelesai"/>
                            </else>
                        </if>
                        <assign variable="DurasiJam" expression="selisihMenit / 60"/>
                        <assign variable="DurasiMenit" expression="selisihMenit mod 60"/>
                        <output expression="DurasiJam" newline="True"/>
                        <output expression="DurasiMenit" newline="True"/>
                        <output expression="&quot;Ulang?lanjut = 1, Tidak lanjut= 0&quot;" newline="True"/>
                        <input variable="Ulang"/>
                    </while>
                </then>
                <else>
                    <output expression="&quot;Tidak Ulang&quot;" newline="True"/>
                    <input variable="jamMulai"/>
                    <input variable="menitMulai"/>
                    <input variable="jamSelesai"/>
                    <input variable="menitSelesai"/>
                    <assign variable="totalMenitMulai" expression="jamMulai * 60 + menitMulai"/>
                    <assign variable="totalMenitSelesai" expression="jamSelesai * 60 + menitSelesai"/>
                    <if expression="totalMenitSelesai &gt;= totalMenitMulai">
                        <then>
                            <assign variable="SelisihMenit" expression="totalMenitSelesai - totalMenitMulai"/>
                        </then>
                        <else>
                            <assign variable="selisihMenit" expression="(24 * 60 - totalMenitMulai) + totalMenitSelesai"/>
                        </else>
                    </if>
                    <assign variable="DurasiJam" expression="selisihMenit / 60"/>
                    <assign variable="DurasiMenit" expression="selisihMenit mod 60"/>
                    <output expression="DurasiJam" newline="True"/>
                    <output expression="DurasiMenit" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
